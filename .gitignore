# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables and secrets (root + any dir). Keep sanitized examples.
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Local databases, backups and WAL/SHM sidecars (personal data — never commit)
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.bak
*.backup

# Private uploads, recordings and voiceprints (backend/uploads/ + any root copy)
uploads/
recordings/
voiceprints/

# Browser automation profiles + runtime state (locked SQLite files, personal data —
# never commit, and never watched by the dev server; see vite.config.js server.watcher).
.tmp-*/
*-profile/
**/browser-profile/
audit/
screenshots/

node_modules
dist
dist-ssr
coverage
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Browser-layout verification harness screenshots (local only — never commit).
# These are per-run artefacts from the `browser-layout-verification` skill; they
# can contain demo-workspace chat UI and are NOT project assets.
verify-*.png
verify-tmp-*.png
_facetest*.png

# Vercel CLI — project linkage lives here; deploy keys / team ids must stay out
# of git even when the repo is public.
.vercel
.vercel/
.env.local
.env.*.local

.vercel
