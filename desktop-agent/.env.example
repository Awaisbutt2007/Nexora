# ─────────────────────────────────────────────────────────────────────────────
# Nexora Desktop Agent — configuration
# Copy this file to `.env` (which is git-ignored) and fill in real values.
# The agent REFUSES TO START with a missing secret or a non-loopback host.
# ─────────────────────────────────────────────────────────────────────────────

# Network binding. SECURITY: only a loopback address is allowed. The agent will
# abort if AGENT_HOST is anything other than 127.0.0.1 / ::1 / localhost, so the
# automation surface is never reachable from another machine on your network.
AGENT_HOST=127.0.0.1
AGENT_PORT=8799

# Shared secret between the Aira backend and this agent. Every mutating request
# to the agent must carry `Authorization: Bearer <this value>`. Put the SAME
# value in backend/.env as DESKTOP_AGENT_SECRET. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_SECRET=

# How many milliseconds an action may run before it is cancelled and reported as
# a timeout. Every action can override this with a smaller value, never larger.
AGENT_ACTION_TIMEOUT_MS=60000

# Absolute directory (or comma-separated list) the agent may READ/LIST/ORGANIZE.
# File operations are REJECTED for any path outside these roots (containment is
# enforced after realpath, so symlink escapes are blocked). Leave empty to keep
# file access denied by default until you add it here or grant it at runtime.
# Example: AGENT_ALLOWED_DIRS=D:\NexoraPlayground
AGENT_ALLOWED_DIRS=

# Absolute folder (or comma-separated list) of approved development tools that
# may be launched by name. Apps are started ONLY from the built-in allowlist
# below mapped to real executables — never from a raw command string. To allow a
# project folder to open in VS Code you must also list it in AGENT_ALLOWED_DIRS.
AGENT_APPROVED_APP_IDS=vscode,chrome,notepad

# Playwright automation. A DEDICATED profile is used so the automation never
# touches your real browser logins, cookies, saved passwords or history.
AGENT_BROWSER=headless chromium
AGENT_BROWSER_PROFILE=./browser-profile
# Only these origins may the browser open (comma-separated hosts). Empty = any
# public http(s) site; set it to lock browsing to an approved allowlist.
AGENT_ALLOWED_HOSTS=

# Where the redacted audit trail is written (one JSON object per line). It never
# stores secrets, passwords, tokens, cookie values, or file bodies.
AGENT_AUDIT_DIR=./audit

# Persistence for granted permissions (default-deny; grants are narrow scopes).
AGENT_DATA_DIR=./data

# ─────────────────────────────────────────────────────────────────────────────
# CLOUD WEB APP + LOCAL AGENT (the browser drives THIS agent directly)
# A hosted Nexora backend can never reach your machine's 127.0.0.1, so the web app
# talks to this agent DIRECTLY instead — gated by a pairing code + a paid-account
# check. Two knobs make that safe (leave both empty to keep browser pairing OFF and
# use only the classic no-Origin backend proxy):
#   AGENT_ALLOWED_ORIGINS  comma-separated web origins a browser may drive the
#     agent from. Include your hosted app AND, for local testing, the dev origin,
#     e.g. http://localhost:5173,https://app.nexora.example
#   NEXORA_BACKEND_URL     the API this agent calls OUTBOUND (never inbound) to
#     confirm a pairing browser owns a real PAID account before minting a token.
#     Pairing is refused while this is empty. e.g. https://api.nexora.example
# Tunables (sane defaults shown): the console code rotates every TTL; a paired
# browser stays connected for CLIENT_TOKEN_TTL_DAYS before it must re-pair.
# ─────────────────────────────────────────────────────────────────────────────
AGENT_ALLOWED_ORIGINS=
NEXORA_BACKEND_URL=
AGENT_PAIR_CODE_TTL_MS=60000
AGENT_PAIR_WINDOW_MS=600000
AGENT_CLIENT_TOKEN_TTL_DAYS=30

# ─────────────────────────────────────────────────────────────────────────────
# SCREEN OBSERVATION & DESKTOP CONTROL (new scopes: screen, desktop)
# Both are DEFAULT-DENY and toggled from the app's Desktop → Permissions tab —
# there is nothing to set here. When enabled, Aira can look at the screen and
# move/click/scroll/type/press safe key combinations on THIS PC.
#
# HOW it works on Windows (Node 24): capture and input use the OS-provided
# .NET surface via PowerShell (System.Drawing for the screenshot, user32.dll and
# SendKeys for input), driven through execFile with fixed argv — NOT robotjs.
# robotjs 0.9.1 is unmaintained and does not compile against Node 24's ABI, so
# it is deliberately not used. There is NO new npm dependency to install, and no
# shell command string is ever built from model output.
#
# Safeguards: every coordinate is validated against the real screen; typing text
# and key presses require a fresh confirmation each time and are never logged;
# there is no Win-key / Ctrl+Alt+Del / UAC surface; a screenshot is held in
# memory and only written to ./screenshots if you explicitly ask to save it.
# ─────────────────────────────────────────────────────────────────────────────
