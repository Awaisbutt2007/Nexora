# Frontend (Vite) environment — SAFE EXAMPLE ONLY. Copy to `.env` for local use.
# Anything prefixed VITE_ is BAKED INTO THE BROWSER BUNDLE at build time.
# NEVER put a secret, API key or token here — those belong only in backend/.env.

# Backend API base URL. LEAVE THIS UNSET (the default) for local development AND for a
# production build: every request is then relative (/api, /uploads), so it goes to whatever
# served the page — Vite's proxy in dev/preview, or the backend itself, which hosts dist/.
# Same-origin means no CORS rule can ever break a login from another port or a LAN address.
# Set it ONLY when the app is deployed apart from its API (a Vercel/Netlify frontend, say);
# the backend must then list that origin in CORS_ORIGIN.
# VITE_API_URL=https://your-api.example.com

# Google OAuth client ID used by "Sign in with Google". This ID is public by
# design (it is not a secret); the secret half lives only on Google's side.
VITE_GOOGLE_CLIENT_ID=

# Local Nexora Agent origin the browser talks to DIRECTLY (cloud web app mode).
# Leave unset to use the default http://127.0.0.1:8799. Change only if the agent
# runs on a different loopback port. This is NOT a secret — it is a loopback URL.
# VITE_AGENT_URL=http://127.0.0.1:8799
